# 模型（OpenAI 兼容接口，换服务商只改这三项）
BRIEFLY_API_KEY=your-key-here
BRIEFLY_BASE_URL=https://api.deepseek.com
BRIEFLY_MODEL=deepseek-flash

# 可选：思考模式 off（默认，关闭）/ on / provider（不传该参数，换成不认识它的服务商时用）
# BRIEFLY_THINKING=off

# 可选：会话记忆所在的 SQLite 文件（默认 data/briefly.db）
# BRIEFLY_DB_PATH=data/briefly.db
# 可选：业务数据库（材料等），默认 SQLite，可换 Postgres 地址
# DATABASE_URL=sqlite:///data/app.db

# 可选：上下文预算（tokens），一般不用改，见 config.py
# 模型的上下文窗口（deepseek-flash 为 1000000）；不填只按 BRIEFLY_MAX_INPUT_TOKENS 控制
# BRIEFLY_CONTEXT_LIMIT=1000000
# BRIEFLY_MAX_INPUT_TOKENS=80000
# BRIEFLY_HISTORY_TOKENS=40000
# BRIEFLY_TURN_TOOL_TOKENS=30000
# BRIEFLY_COMPACT_TRIGGER_TOKENS=30000

# 文件追踪（可选，以下为默认值）
# BRIEFLY_TRACKING_DIR=data/tracking
# BRIEFLY_TRACKING_MAX_FILE_MB=50
# BRIEFLY_TRACKING_MAX_STORE_MB=2048
# BRIEFLY_TRACKING_DAILY_TIME=18:00
# BRIEFLY_TRACKING_TIMEZONE=Asia/Shanghai
# BRIEFLY_TRACKING_WORKDAYS_ONLY=1
# BRIEFLY_TRACKING_SCHEDULER=1
