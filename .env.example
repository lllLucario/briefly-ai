# 模型（OpenAI 兼容接口，换服务商只改这三项）
BRIEFLY_API_KEY=your-key-here
BRIEFLY_BASE_URL=https://api.deepseek.com
BRIEFLY_MODEL=deepseek-flash

# 可选：思考模式 off（默认，关闭）/ on / provider（不传该参数，换成不认识它的服务商时用）
# BRIEFLY_THINKING=off

# 可选：会话记忆所在的 SQLite 文件（默认 data/briefly.db）；用 PostgreSQL 时不读它，会话记录放在同一个数据库
# BRIEFLY_DB_PATH=data/briefly.db
# 可选：业务数据库，默认 SQLite。指向 PostgreSQL 时，业务数据、会话记录、知识和工作区索引都放到这个库（需安装 .[postgres]，见 README）
# DATABASE_URL=sqlite:///data/app.db
# DATABASE_URL=postgresql://briefly:<密码>@127.0.0.1:55432/briefly
# 本地开发用的 PostgreSQL 容器（docker-compose.dev.yml）的密码；只放在 .env，不提交
# BRIEFLY_PG_PASSWORD=<随机密码>
# 只有测试用：设了就让全量测试跑在 PostgreSQL 上（每个用例一个独立 schema），不要指向有数据的库
# BRIEFLY_TEST_DATABASE_URL=postgresql://briefly:<密码>@127.0.0.1:55432/briefly

# 旧版Word兼容转换路径：LibreOffice；不填时查PATH与常见安装路径。
# BRIEFLY_LIBREOFFICE=C:/Program Files/LibreOffice/program/soffice.com
# BRIEFLY_DOC_CONVERSION_TIMEOUT_S=90
# BRIEFLY_OFFICE_PROFILE_TEMPLATE=on
# BRIEFLY_PPT_PARSER=auto
# 优先直接解析旧Word（需Java17+和Tika3.3.3）；auto依赖缺失时记录后转用LibreOffice。
# BRIEFLY_DOC_PARSER=auto
# BRIEFLY_JAVA=C:/runtime/jre/bin/java.exe
# BRIEFLY_TIKA_APP_JAR=C:/runtime/tika-app-3.3.3.jar
# 知识入库：本地模型目录须先离线准备；不自动下载或上传原文。
# BRIEFLY_EMBEDDING_DIR=C:/models/bge-small-zh-v1.5
# BRIEFLY_KNOWLEDGE_DIR=data/knowledge
# BRIEFLY_PARSE_TIMEOUT_S=120
# 图片文字识别：pip install -e ".[ocr]"（模型随 rapidocr 包分发，本地推理，不联网）；off 关闭。
# BRIEFLY_OCR=auto
# BRIEFLY_OCR_MAX_PAGES=40
# BRIEFLY_OCR_MAX_IMAGES=60
# BRIEFLY_OCR_TIME_BUDGET_S=80
# BRIEFLY_OCR_MIN_CONFIDENCE=0.85

# 可选：上下文预算（tokens），一般不用改，见 config.py
# 模型的上下文窗口（deepseek-flash 为 1000000）；不填只按 BRIEFLY_MAX_INPUT_TOKENS 控制
# BRIEFLY_CONTEXT_LIMIT=1000000
# BRIEFLY_MAX_INPUT_TOKENS=80000
# BRIEFLY_HISTORY_TOKENS=40000
# BRIEFLY_TURN_TOOL_TOKENS=30000
# BRIEFLY_COMPACT_TRIGGER_TOKENS=30000

# 文件追踪（可选，以下为默认值）
# BRIEFLY_TRACKING_DIR=data/tracking
# BRIEFLY_TRACKING_MAX_FILE_MB=50
# BRIEFLY_TRACKING_MAX_STORE_MB=2048
# BRIEFLY_TRACKING_DAILY_TIME=18:00
# BRIEFLY_TRACKING_TIMEZONE=Asia/Shanghai
# BRIEFLY_TRACKING_WORKDAYS_ONLY=1
# BRIEFLY_TRACKING_SCHEDULER=1

# 飞书（可选，阶段 4）：企业自建应用的凭证，在开发者后台“凭证与基础信息”获取
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# 你自己的飞书 open_id（ou_ 开头）或飞书邮箱：写入的文档自动加你为协作者，周报准备好时机器人发消息给你
# 注意：普通邮箱（QQ、Gmail 等）不行，飞书找不到对应用户。open_id 可以在你拥有的文档上用 briefly 读取后看“最后编辑人”，或在开发者后台 API 调试台查
# FEISHU_NOTIFY_USER=ou_xxx
# 写入文档的文件夹 token（链接 /drive/folder/ 后面那段；应用需有编辑权限），留空放在应用空间
# FEISHU_FOLDER_TOKEN=
# 生成链接用的域名，如 https://xxx.feishu.cn
# FEISHU_DOC_DOMAIN=
# 国际版 Lark 改为 https://open.larksuite.com
# FEISHU_BASE_URL=https://open.feishu.cn

# 邮件（可选，阶段 5）：发送周报。QQ 邮箱在“设置 → 账号”、163 邮箱在“设置 → POP3/SMTP/IMAP”开启 SMTP 服务并获取授权码（不是登录密码）；163 用 smtp.163.com
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASSWORD=授权码
# MAIL_FROM_NAME=张三
# MAIL_DEFAULT_TO=mentor@example.com

# 日志（可选）：每行一条 JSON，带请求追踪号；不记录文档正文、问题原文、模型回答和密钥
# BRIEFLY_LOG_LEVEL=INFO
# BRIEFLY_LOG_FILE=data/logs/briefly.log

# 访问控制（可选）：设了令牌就要求登录；没设时只能绑定本机地址。用足够长的随机值，只放 .env
# BRIEFLY_ACCESS_TOKEN=
# BRIEFLY_SESSION_DAYS=7
# 允许的访问主机名，不含端口；用其他地址访问时要加进去
# BRIEFLY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 模型单次请求的超时（秒）和重试次数；不填用 300 和 1
# BRIEFLY_MODEL_TIMEOUT_S=300
# BRIEFLY_MODEL_MAX_RETRIES=1
# 粘贴文字和普通材料上传共用的大小上限（MB），默认 10；不影响知识库
# BRIEFLY_MAX_UPLOAD_MB=10
# 知识库单个文件的大小上限（MB），默认 50；知识库接口另有单批 50MB 的限制
# BRIEFLY_MAX_KNOWLEDGE_FILE_MB=50
# 普通请求体（主要是 JSON）的总上限（MB），只防滥用；实际不低于上面的 3 倍
# BRIEFLY_MAX_JSON_MB=32
# 知识库单次批量上传的请求总量（MB）。100 是保守占位，之后还要再改；接口里另有单批 50MB 的限制
# BRIEFLY_MAX_IMPORT_BATCH_MB=100
# 模型响应缓存：按白名单缓存通过检查的结果，降低重复请求的成本和延迟；off 时和没有缓存完全一样
# BRIEFLY_LLM_CACHE=on
# BRIEFLY_LLM_CACHE_TTL_HOURS=168
# BRIEFLY_LLM_CACHE_MAX_ENTRIES=5000
